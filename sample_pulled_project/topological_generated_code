# ACTION EVENT HELPERS (*>&1)
function Execute-LexiconLookup {
    `$promptText = `$txtPrompt.Text
    if (Test-Path ".\topological_dictionary.exe") {
        `$promptClean = `$promptText -replace "`r`n", " " -replace "`n", " "
        `$result = & ".\topological_dictionary.exe" `$promptClean *>&1 | Out-String
        `$txtLexiconOut.Text = `$result
    }
}

function Execute-BraidCompression {
    `$promptText = `$txtPrompt.Text
    if (Test-Path ".\topological_geometric_tokenizer.exe") {
        `$promptClean = `$promptText -replace "`r`n", " " -replace "`n", " "
        `$result = & ".\topological_geometric_tokenizer.exe" `$promptClean *>&1 | Out-String
        `$txtBraidOut.Text = `$result
    }
}

function Execute-DomainSynthesis {
    `$promptText = `$txtPrompt.Text
    `$selectedLang = `$cmbDomainLang.SelectedItem.ToString()
    `$outputMode = `$cmbOutputMode.SelectedItem.ToString()

    if (Test-Path ".\topological_semantic_compiler.exe") {
        `$promptClean = `$promptText -replace "`r`n", " " -replace "`n", " "
        `$rawCode = & ".\topological_semantic_compiler.exe" `$promptClean `$selectedLang *>&1 | Out-String
        
        `$cleanSource = `$rawCode -replace "^```[a-zA-Z]*`r?`n", "" -replace "`r?`n```$", ""

        if (`$outputMode -eq "PS Script") {
            `$selectedLower = `$selectedLang.ToLower()
            `$ext = ".py"
            `$execCmd = "python3 .\topological_generated_code.py"

            if (`$selectedLower -eq "rust") {
                `$ext = ".rs"
                `$execCmd = "rustc -O topological_generated_code.rs -o topological_generated_code.exe`r`n.\topological_generated_code.exe"
            } elseif (`$selectedLower -eq "c/c++") {
                `$ext = ".cpp"
                `$execCmd = "g++ -O3 topological_generated_code.cpp -o topological_generated_code.exe`r`n.\topological_generated_code.exe"
            } elseif (`$selectedLower -eq "typescript") {
                `$ext = ".ts"
                `$execCmd = "deno run topological_generated_code.ts"
            }

            `$psBlock = @"
Set-Location "C:\sovereign_manifold\santos-sync\topological_system_optimizer"

@'
$cleanSource
